# The read-only fleet page — an add-on, off unless someone switches it on.
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o web ./cmd/web

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/web .
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/web"]
